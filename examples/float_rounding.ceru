// 乗算と加算はそれぞれの型で丸めます。FMAへまとめると結果が変わる例です。
fn step32(a: f32, b: f32, c: f32) -> f32 { return a * b + c; }
fn step64(a: f64, b: f64, c: f64) -> f64 { return a * b + c; }

a: f32 = 1.00000011920928955078125;
b: f32 = 0.99999988079071044921875;
x: f64 = 1.0000000000000002220446049250313080847263336181640625;
y: f64 = 0.9999999999999997779553950749686919152736663818359375;
// 積は1に丸められ、そこから1を引くため、どちらも+0です。
values32: [f32] = array_copy([step32(a, b, -1.0)]);
values64: [f64] = array_copy([step64(x, y, -1.0)]);
print(values32[0]);
print(values64[0]);
// この桁では1の加算が丸めで失われます。加算をまとめ直しません。
print((16777216.0f32 + 1.0f32) - 16777216.0f32);
print((9007199254740992.0 + 1.0) - 9007199254740992.0);
print(-0.0f32 * 1.0f32);
print(-0.0 * 1.0);
infinity: f64 = 1.0 / 0.0;
nan: f64 = infinity - infinity;
print(infinity > 0.0);
print(nan != nan);
