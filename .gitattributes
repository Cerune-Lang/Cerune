# 生成用文字列に他言語のコードを含むRustも正しく分類します。
*.rs linguist-language=Rust

tests/fixtures/** text eol=lf
tests/fixtures/dynamic-arrays/c.c -linguist-detectable
tests/fixtures/dynamic-arrays/*.ll -linguist-detectable
tests/fixtures/dynamic-arrays/*.ssa -linguist-detectable
tests/fixtures/dynamic-arrays/*.wat -linguist-detectable
tests/fixtures/dynamic-arrays/*.s -linguist-detectable
tests/fixtures/dynamic-arrays/nested.stdout -text
scripts/*.ps1 -linguist-detectable
scripts/*.sh text eol=lf -linguist-detectable
scripts/*.cjs text eol=lf -linguist-detectable

# 検証用言語・補助ツール・出力比較用fixtureは言語集計から外します。
# linguist-generatedは使わず、観測結果と証明のdiffを表示したままにします。
experiments/lean/** -linguist-detectable
tests/**/*.cjs -linguist-detectable
tests/**/*.lean -linguist-detectable
tests/fixtures/observation/**/expected/** -linguist-detectable
examples/io_protocol/*.stdout text eol=lf
examples/io_protocol/output_sequence.stdout -text
examples/io_protocol/explicit_flush.stdout -text

# 同梱仮想ソースの本文とSpanをcheckout先OSに依存させません。
src/standard/*.ceru text eol=lf
tests/fixtures/line_input.stdin -text

tests/support/input_memory.c text eol=lf -linguist-detectable
tests/support/input_memory_probe.c text eol=lf -linguist-detectable

# Host-call adapters and tools are experiments, not language implementation.
experiments/host_calls/** -linguist-detectable
examples/host_calls/*.ceru text eol=lf

tests/support/native_runtime_reference/*.s text eol=lf -linguist-detectable
examples/call_frames/*.stdout text eol=lf

experiments/call_depth/*.cjs text eol=lf -linguist-detectable

examples/recursion/*.stdout text eol=lf
