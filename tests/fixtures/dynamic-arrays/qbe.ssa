  call $putchar(w 34)
  jmp @condition
@condition
  %index =l phi @start 0, @write %next
  %done =w ceql %index, %length
  jnz %done, @end, @write
@write
  %offset =l add %index, 8
  %ptr =l add %value, %offset
  %byte =w loadub %ptr
  call $cerune_write_escaped_byte(w %byte)
  %next =l add %index, 1
  jmp @condition
@end
  call $putchar(w 34)
  ret
}
