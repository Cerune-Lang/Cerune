function l $cerune_output_write(l %data, l %length) {
@start
  %result =l call $write(w 1, l %data, l %length)
  ret %result
}
function $cerune_output_diagnostic(l %data, w %length) {
@start
  %positive =w csgtw %length, 0
  jnz %positive, @bound, @exit
@bound
