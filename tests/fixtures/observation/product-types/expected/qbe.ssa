  %total =l add %accepted, %n
  storel %total, %accepted_ptr
  %next =l add %cursor, %n
  %rest =l sub %remaining, %n
  jmp @condition
@failed
  call $cerune_output_failed(l %op)
  hlt
@end
  ret
}
section ".rodata" data $cerune_output_format_i64 = { b "%lld", b 0 }
function $cerune_output_i64(l %value, w %newline, l %origin) {
@start
