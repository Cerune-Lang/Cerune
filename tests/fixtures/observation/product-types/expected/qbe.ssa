@failed
  %error =l alloc8 512
  %error_length =w call $snprintf(l %error, l 512, l $cerune_output_format_error, ..., l %origin)
  call $cerune_output_diagnostic(l %error, w %error_length)
  hlt
@formatted
  %length =l extuw %n
  %tail =l add %text, %length
  storeb 10, %tail
  %extra =l extuw %newline
  %requested =l add %length, %extra
  call $cerune_output_text(l %text, l %requested, l %origin)
  ret
}
