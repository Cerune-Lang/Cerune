  %saved =l add %op, 24
  storel %prior, %saved
  %bad =w ceql %prior, -1
  jnz %bad, @failed, @done
@failed
  call $cerune_output_failed(l %op)
  hlt
@done
  ret
}
function $cerune_output_end(l %op) {
@start
  %saved =l add %op, 24
  %prior =l loadl %saved
  %restored =l call $signal(w 13, l %prior)
  %bad =w ceql %restored, -1
  jnz %bad, @failed, @done
@failed
  call $cerune_output_failed(l %op)
  hlt
@done
  ret
}

function $cerune_output_part(l %op, l %data, l %length) {
@start
  %accepted_ptr =l add %op, 8
  jmp @condition
@condition
