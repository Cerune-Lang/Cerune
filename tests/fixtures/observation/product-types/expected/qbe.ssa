  %wide =l extuw %count
  call $write(w 2, l %data, l %wide)
  jmp @exit
@exit
  call $_Exit(w 1)
  hlt
}

function $cerune_output_failed(l %op) {
@start
  %requested =l loadl %op
  %accepted_ptr =l add %op, 8
  %accepted =l loadl %accepted_ptr
  %origin_ptr =l add %op, 16
