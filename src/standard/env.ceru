// std:env contract version 1. Arguments are fixed before execution.
pub enum Argument {
    Value { text: string },
    Missing
}

pub fn arg_count() -> i64 {
    return __cerune_arg_count();
}

pub fn arg(index: i64) -> Argument {
    if index >= __cerune_arg_count() {
        return Argument::Missing {};
    }
    return Argument::Value { text: __cerune_arg_get(index) };
}
